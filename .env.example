# ====================================================
# AI WEEKLY NEWSLETTER CONFIGURATION FILE
# ====================================================

# Google Gemini API Settings (Primary AI Provider)
# Obtain a free key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-pro

# Ollama Local LLM Settings (Optional Fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Sentence-Transformers Embedding Settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# SMTP / Email Settings (Optional)
# Supports standard Gmail App Passwords or customized SMTP endpoints
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_TO_EMAIL=receiver_email@gmail.com

# Slack Integration Settings (Optional)
SLACK_WEBHOOK_URL=

# Application Environment
ENV=development
